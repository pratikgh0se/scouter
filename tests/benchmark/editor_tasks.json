        {
          "tool": "darkroom_set",
          "args": {
            "module": "exposure",
            "param": "exposure",
            "value": {
              "$hist": {
                "step": 0,
                "op": "exposure",
                "param": "exposure",
                "add": 1.0,
                "fallback": 1.7
              }
            }
          }
        }
      ],
      "assertions": {
        "set_ok": {
          "type": "step_ok",
          "step": 1
        },
        "delta": {
          "type": "param_delta",
          "frame": "dark",
          "module": "exposure",
          "param": "exposure",
          "delta": 1.0,
          "tol": 0.02
