{
  "schema": "scouter-editor-tasks/1",
  "decision_row": 406,
  "written": "2026-09-24",
  "about": "The Scouter editor benchmark: sentences a photo editor would say to Claude, the MCP calls a competent agent makes for each one (the 'agent plan'), and machine-checkable assertions read back from the XMP sidecar darktable wrote, the tool envelopes, or files on disk. Deterministic: no model runs; the plan is fixed data; every value an agent would compute from a tool result is computed by the same rule from that result ($hist / $ref resolvers).",
  "scoring_rules": {
    "pass": "every assertion in scoring.pass holds AND the task finished inside budget_s",
    "pass_over_budget": "every pass assertion holds but wall time > budget_s -> scored partial, outcome 'over_budget'",
    "partial": "pass does not hold, but every assertion of at least one group in scoring.partial holds (criteria spelled out per task in scoring.partial_criteria)",
    "fail": "anything else. The outcome label says which kind: honest_refusal (every assertion in scoring.refusal holds: a typed refusal and nothing written), reported_ok_unverified (the last tool envelope said ok but the read-back does not confirm it), blocked (the darktable session was wedged or never came up), failed (everything else)",
    "correct_refusal": "for category 'unreachable' the refusal IS the pass condition"
  },
  "frames": {
